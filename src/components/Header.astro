---
import { Icon } from "astro-icon/components";
const authors = [
  { name: "Yi Wang", affiliation: "1", url: "https://wanglne.github.io/" },
  {
    name: "Rui Qian",
    affiliation: "2",
    url: "https://openreview.net/profile?id=~Rui_Qian5",
  },
  { name: "Yu Li", affiliation: "3", url: "https://elevenliy.github.io/" },
  {
    name: "Haoyang Yao",
    affiliation: "4",
    url: "https://openreview.net/profile?id=%7EHaoyang_Yao1",
  },
  { name: "Wenjie Wang", affiliation: "1,†", url: "https://wwj95.github.io/" },
];
const affiliations = [
  "ShanghaiTech University",
  "Fudan University",
  "Southeast University",
  "Peking University",
];
const links = [
  {
    name: "Paper",
    url: "https://arxiv.org/pdf/2610.10623",
    icon: "ri:file-pdf-2-line",
  },
  {
    name: "arXiv",
    url: "https://arxiv.org/abs/2610.10623",
    icon: "academicons:arxiv",
  },
  { name: "Code", icon: "ri:github-line" },
  { name: "Models", icon: "huggingface" },
];
---

<header class="publication-header full-bleed">
  <div class="header-inner">
    <h1 class="publication-title">
      <span class="title-opening"
        >Recurrent <span class="keep-together">Self-Improvement:</span></span
      >
      <span
        >Dynamic <span class="keep-together">Cross-Loop</span>
        <span class="keep-together">On-Policy</span> Distillation</span
      >
      <span>for Looped Language Models</span>
    </h1>
    <div class="authors">
      {
        // prettier-ignore
        authors.map((author) => (
          <span>{author.url ? <a href={author.url} target="_blank" rel="noopener noreferrer">{author.name}</a> : author.name}<sup>{author.affiliation}</sup></span>
        ))
      }
    </div>
    <div class="affiliations">
      {
        // prettier-ignore
        affiliations.map((name, i) => (
          <span><sup>{i + 1}</sup>{name}</span>
        ))
      }
    </div>
    <p class="author-notes"><sup>†</sup>Corresponding author.</p>
    <div class="publication-links" aria-label="Research resources">
      {
        links.map((link) =>
          link.url ? (
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              <>
                <Icon name={link.icon} />
                <span>{link.name}</span>
              </>
            </a>
          ) : (
            <span
              class="resource-pending"
              aria-label={`${link.name}: Coming soon`}
            >
              <>
                <Icon name={link.icon} />
                <span>{link.name}</span>
                <small>Coming soon</small>
              </>
            </span>
          ),
        )
      }
    </div>
  </div>
</header>

---
import { Font } from "astro:assets";

import Table from "../components/Table.astro";

import "../styles/global.css";
import "../styles/loopopd.css";

import { Content, frontmatter } from "../paper.mdx";

interface Frontmatter {
  title: string;
  description?: string;
  favicon: string;
  thumbnail?: string;
  theme?: "device" | "light" | "dark";
}

const {
  title,
  description,
  favicon,
  thumbnail,
  theme = "device",
} = frontmatter as Frontmatter;

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
const canonical = Astro.site ? new URL(prefix, Astro.site).href : undefined;
const socialImage = thumbnail
  ? Astro.site
    ? new URL(prefix + thumbnail, Astro.site).href
    : prefix + thumbnail
  : undefined;
---

<!doctype html>
<html class="bg-zinc-50" lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    {description && <meta name="description" content={description} />}
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (() => {
        const navigation = performance.getEntriesByType("navigation")[0];
        if (location.hash || navigation?.type === "back_forward") return;

        // A plain entry or reload starts at the title. Preserve back/forward
        // restoration, anchor links, and scrolling begun while the page loads.
        let interacted = false;
        const markInteraction = () => {
          interacted = true;
        };
        const inputs = ["touchstart", "wheel", "keydown"];
        inputs.forEach((type) =>
          window.addEventListener(type, markInteraction, {
            once: true,
            passive: true,
          }),
        );
        window.addEventListener(
          "pageshow",
          (event) => {
            requestAnimationFrame(() => {
              inputs.forEach((type) =>
                window.removeEventListener(type, markInteraction),
              );
              if (!event.persisted && !interacted && !location.hash) {
                window.scrollTo({ top: 0, left: 0, behavior: "instant" });
              }
            });
          },
          { once: true },
        );
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href={prefix + favicon} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <Font
      cssVariable="--font-noto-sans"
      preload={[{ subset: "latin", style: "normal" }]}
    />
    <Font
      cssVariable="--font-google-sans"
      preload={[{ subset: "latin", style: "normal" }]}
    />

    <title>{title}</title>
  </head>
  <body class="font-(family-name:--font-noto-sans)">
    <main>
      <Content components={{ table: Table }} />
    </main>
    <footer class="page-footer">
      <p>
        Built with <a
          href="https://research-template.roman.technology"
          target="_blank"
          rel="nofollow noopener noreferrer"
          >Roman Hauksson-Neill's project page template</a
        >
      </p>
    </footer>
  </body>
</html>
